            SliderTrack.Position = UDim2.new(0, 14, 0, 42)
            SliderTrack.BackgroundColor3 = Color3.fromRGB(38, 42, 56)
            Instance.new("UICorner", SliderTrack).CornerRadius = UDim.new(1, 0)

            local SliderFill = Instance.new("Frame", SliderTrack)
            SliderFill.Name = "SliderFill"
            SliderFill.Size = UDim2.new((Value - min) / (max - min), 0, 1, 0)
            SliderFill.BackgroundColor3 = Library.CurrentTheme.Accent
            Instance.new("UICorner", SliderFill).CornerRadius = UDim.new(1, 0)

            local SliderKnob = Instance.new("Frame", SliderFill)
            SliderKnob.Name = "SliderKnob"
            SliderKnob.Size = UDim2.new(0, 14, 0, 14)
            SliderKnob.Position = UDim2.new(1, -7, 0.5, -7)
            SliderKnob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            Instance.new("UICorner", SliderKnob).CornerRadius = UDim.new(1, 0)

            local dragging = false

            local function UpdateSlider(inputX)
                local perc = math.clamp((inputX - SliderTrack.AbsolutePosition.X) / SliderTrack.AbsoluteSize.X, 0, 1)
                Value = math.floor((min + (max - min) * perc) * 10) / 10
                SliderFill.Size = UDim2.new(perc, 0, 1, 0)
                ValLabel.Text = tostring(Value)
                if callback then callback(Value) end
            end

            table.insert(Library.Connections, SliderTrack.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    dragging = true
                    _G.IsDraggingSlider = true
                    UpdateSlider(input.Position.X)
                end
            end))

            table.insert(Library.Connections, UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    dragging = false
                    _G.IsDraggingSlider = false
                end
            end))

            table.insert(Library.Connections, UserInputService.InputChanged:Connect(function(input)
                if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                    UpdateSlider(input.Position.X)
                end
            end))
        end

