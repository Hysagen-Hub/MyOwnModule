            if binding or not bindEnabled or UserInputService:GetFocusedTextBox() then return end
            if input.KeyCode == currentKey then setToggle(not toggled) end
        end)
        table.insert(conns, c4)
        table.insert(Library.Connections, c4)

        -- Очистка
        local c5 = row.AncestryChanged:Connect(function()
            if not row.Parent then
                for _, c in ipairs(conns) do if c and c.Disconnect then c:Disconnect() end end
            end
        end)
        table.insert(conns, c5)
        table.insert(Library.Connections, c5)
    end

