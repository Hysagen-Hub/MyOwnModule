-- ──────────────── ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ ────────────────
local function makeDraggable(gui)
    local drag = false
    local start, pos
    local conns = {}

    local function update(input)
        if not drag then return end
        local delta = input.Position - start
        gui.Position = UDim2.new(pos.X.Scale, pos.X.Offset + delta.X, pos.Y.Scale, pos.Y.Offset + delta.Y)
    end

    table.insert(conns, gui.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 and not _G.IsDraggingSlider then
            drag = true
            start = i.Position
            pos = gui.Position
        end
    end))

    table.insert(conns, gui.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then drag = false end
    end))

    table.insert(conns, UserInputService.InputChanged:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseMovement and drag and not _G.IsDraggingSlider then
            update(i)
        end
    end))

    return conns
end

