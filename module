-- ──────────────── СОХРАНЕНИЕ ТЕМЫ ────────────────
local function loadTheme()
    local ok, data = pcall(function() return HttpService:JSONDecode(readfile(THEME_FILE)) end)
    return ok and data and data.theme or nil
end

local function saveTheme(name)
    pcall(function()
        writefile(THEME_FILE, HttpService:JSONEncode({ theme = name }))
    end)
end

