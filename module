        -- Tab Selection Handler
        local function SelectTab()
            for _, btn in ipairs(Library.TabButtons) do
                btn:SetAttribute("Active", false)
                CreateTween(btn, 0.25, {
                    BackgroundColor3 = Library.CurrentTheme.Secondary,
                    TextColor3 = Library.CurrentTheme.SubText
                })
                local stroke = btn:FindFirstChildOfClass("UIStroke")
                if stroke then CreateTween(stroke, 0.25, { Transparency = 1 }) end
            end

            for _, pg in ipairs(Library.Tabs) do
                pg.Visible = false
            end

            TabBtn:SetAttribute("Active", true)
            CreateTween(TabBtn, 0.25, {
                BackgroundColor3 = Library.CurrentTheme.Accent,
                TextColor3 = Library.CurrentTheme.BtnText
            })
            CreateTween(TabBtnStroke, 0.25, { Transparency = 0.4 })

            Page.Visible = true
            Library.ActiveTab = Page
        end

        table.insert(Library.Connections, TabBtn.MouseButton1Click:Connect(SelectTab))

        if #Library.Tabs == 1 then
            SelectTab()
        end

