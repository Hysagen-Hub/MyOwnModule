    -- Dynamic Theme Applicator
    function Library:ApplyTheme(themeName)
        local theme = Themes[themeName] or Themes["Midnight"]
        Library.CurrentTheme = theme

        CreateTween(Main, 0.35, { BackgroundBackgroundColor3 = theme.Main })
        CreateTween(Sidebar, 0.35, { BackgroundColor3 = theme.Sidebar })
        CreateTween(MainStroke, 0.35, { Color = theme.Stroke })
        CreateTween(TitleLabel, 0.35, { TextColor3 = theme.Text })
        SidebarScroll.ScrollBarImageColor3 = theme.Accent

        for _, tabBtn in pairs(Library.TabButtons) do
            if tabBtn:GetAttribute("Active") then
                CreateTween(tabBtn, 0.3, { BackgroundColor3 = theme.Accent, TextColor3 = theme.BtnText })
                local stroke = tabBtn:FindFirstChildOfClass("UIStroke")
                if stroke then CreateTween(stroke, 0.3, { Color = theme.AccentGlow, Transparency = 0.3 }) end
            else
                CreateTween(tabBtn, 0.3, { BackgroundColor3 = theme.Secondary, TextColor3 = theme.SubText })
                local stroke = tabBtn:FindFirstChildOfClass("UIStroke")
                if stroke then CreateTween(stroke, 0.3, { Transparency = 1 }) end
            end
        end

        for _, page in pairs(ContentFolder:GetChildren()) do
            for _, row in pairs(page:GetDescendants()) do
                if row.Name == "Row" then
                    CreateTween(row, 0.3, { BackgroundColor3 = theme.Secondary })
                    local rowStroke = row:FindFirstChildOfClass("UIStroke")
                    if rowStroke then CreateTween(rowStroke, 0.3, { Color = theme.Stroke }) end
                elseif row.Name == "RowTitle" or row.Name == "LabelText" then
                    CreateTween(row, 0.3, { TextColor3 = theme.Text })
                elseif row.Name == "ActionBtn" then
                    CreateTween(row, 0.3, { BackgroundColor3 = theme.Accent, TextColor3 = theme.BtnText })
                elseif row.Name == "SliderFill" then
                    CreateTween(row, 0.3, { BackgroundColor3 = theme.Accent })
                end
            end
        end

        SaveTheme(themeName)
    end

