    main.Name = "MainFrame"
    main.Size = UDim2.new(0, 660, 0, 460)
    main.Position = UDim2.new(0.5, -330, 0.5, -230)
    main.BackgroundColor3 = currentTheme.bg
    main.BackgroundTransparency = 0.3
