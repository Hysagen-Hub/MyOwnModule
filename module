        label.Position = UDim2.new(0, 12, 0, 4)
        label.Text = text .. ": " .. default
        label.TextColor3 = currentTheme.text
        label.Font = Enum.Font.GothamMedium
        label.TextSize = 15
        label.BackgroundTransparency = 1
        label.TextXAlignment = Enum.TextXAlignment.Left

        local sliderBack = Instance.new("Frame", row)
        sliderBack.Name = "SliderBack"
        sliderBack.Size = UDim2.new(1, -30, 0, 6)
        sliderBack.Position = UDim2.new(0, 15, 0, 52)
        sliderBack.BackgroundColor3 = Color3.fromRGB(40, 40, 60)
        local sbCorner = Instance.new("UICorner", sliderBack)
        sbCorner.CornerRadius = UDim.new(0, 4)

        local sliderFill = Instance.new("Frame", sliderBack)
        sliderFill.Name = "SliderFill"
        sliderFill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
        sliderFill.BackgroundColor3 = currentTheme.accent
        local sfCorner = Instance.new("UICorner", sliderFill)
        sfCorner.CornerRadius = UDim.new(0, 4)

        local knob = Instance.new("Frame", sliderFill)
        knob.Name = "SliderKnob"
        knob.Size = UDim2.new(0, 18, 0, 18)
        knob.Position = UDim2.new(1, -9, 0.5, -9)
        knob.BackgroundColor3 = currentTheme.accent
        local kCorner = Instance.new("UICorner", knob)
        kCorner.CornerRadius = UDim.new(1, 0)
        local kStroke = Instance.new("UIStroke", knob)
        kStroke.Color = Color3.fromRGB(0, 0, 0)
        kStroke.Transparency = 0.6

        local dragging = false

        local function updateFromMouse(mouseX)
            local barX = sliderBack.AbsolutePosition.X
            local barW = sliderBack.AbsoluteSize.X
            local perc = math.clamp((mouseX - barX) / barW, 0, 1)
            local val = min + (max - min) * perc
            val = math.floor(val * 10) / 10
            sliderFill.Size = UDim2.new(perc, 0, 1, 0)
            label.Text = text .. ": " .. val
            if callback then callback(val) end
        end

        local c1 = sliderBack.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = true
                _G.IsDraggingSlider = true
                updateFromMouse(i.Position.X)
            end
        end)
        table.insert(Library.Connections, c1)

        local c2 = knob.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = true
                _G.IsDraggingSlider = true
            end
        end)
        table.insert(Library.Connections, c2)

        local c3 = UserInputService.InputEnded:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = false
                _G.IsDraggingSlider = false
            end
        end)
        table.insert(Library.Connections, c3)

        local c4 = UserInputService.InputChanged:Connect(function(i)
            if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then
                updateFromMouse(i.Position.X)
            end
        end)
        table.insert(Library.Connections, c4)
    end

    function TabBase:AddToggleButton(text, default, callback)
        self.Count = self.Count + 1
        local toggled = default or false

        local row = Instance.new("Frame", self.Page)
        row.Name = "Row"
        row.Size = UDim2.new(1, -10, 0, 58)
        row.BackgroundColor3 = currentTheme.secondary
        row.LayoutOrder = self.Count
        row.BackgroundTransparency = 0.15
        Instance.new("UICorner", row).CornerRadius = UDim.new(0, 10)

        local label = Instance.new("TextLabel", row)
        label.Size = UDim2.new(0.6, 0, 1, 0)
        label.Position = UDim2.new(0, 12, 0, 0)
        label.Text = text
        label.TextColor3 = currentTheme.text
        label.Font = Enum.Font.GothamMedium
        label.TextSize = 15
        label.BackgroundTransparency = 1
        label.TextXAlignment = Enum.TextXAlignment.Left

        local toggleBtn = Instance.new("TextButton", row)
        toggleBtn.Name = "ToggleBtnFrame"
        toggleBtn.Size = UDim2.new(0.3, 0, 0, 36)
        toggleBtn.Position = UDim2.new(0.65, 0, 0.5, -18)
        toggleBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 45)
        toggleBtn.Text = ""
        toggleBtn.AutoButtonColor = false
        local tbCorner = Instance.new("UICorner", toggleBtn)
        tbCorner.CornerRadius = UDim.new(0, 8)

        local dot = Instance.new("Frame", toggleBtn)
        dot.Size = UDim2.new(0, 10, 0, 10)
        dot.Position = UDim2.new(0, 8, 0.5, -5)
        dot.BackgroundColor3 = toggled and Color3.fromRGB(80, 255, 120) or Color3.fromRGB(255, 80, 80)
        dot.BorderSizePixel = 0
        local dc = Instance.new("UICorner", dot)
        dc.CornerRadius = UDim.new(1, 0)

        local statusLabel = Instance.new("TextLabel", toggleBtn)
        statusLabel.Size = UDim2.new(1, -25, 1, 0)
        statusLabel.Position = UDim2.new(0, 22, 0, 0)
        statusLabel.BackgroundTransparency = 1
        statusLabel.Text = toggled and "ON" or "OFF"
        statusLabel.TextColor3 = toggled and Color3.fromRGB(80, 255, 120) or Color3.fromRGB(255, 80, 80)
        statusLabel.Font = Enum.Font.GothamBold
        statusLabel.TextSize = 13
        statusLabel.TextXAlignment = Enum.TextXAlignment.Left

        local c = toggleBtn.MouseButton1Click:Connect(function()
            toggled = not toggled
            local col = toggled and Color3.fromRGB(80, 255, 120) or Color3.fromRGB(255, 80, 80)
            local txt = toggled and "ON" or "OFF"
            TweenService:Create(dot, TweenInfo.new(0.25), { BackgroundColor3 = col }):Play()
            TweenService:Create(statusLabel, TweenInfo.new(0.25), { TextColor3 = col }):Play()
            statusLabel.Text = txt
            if callback then callback(toggled) end
        end)
        table.insert(Library.Connections, c)
    end

    -- ─── СОЗДАНИЕ ВКЛАДКИ ───
    function Library:CreateTab(name, isSettings)
        local tab = setmetatable({ Count = 0 }, TabBase)

        local btn = Instance.new("TextButton", sidebarScroll)
        btn.Name = "TabBtn"
        btn.Size = UDim2.new(0.95, 0, 0, 42)
        btn.BackgroundColor3 = currentTheme.secondary
        btn.Text = name
        btn.TextColor3 = currentTheme.text
        btn.Font = Enum.Font.GothamBold
        btn.TextSize = 16
        local btnCorner = Instance.new("UICorner", btn)
        btnCorner.CornerRadius = UDim.new(0, 8)
        table.insert(Library.Buttons, btn)

        local page = Instance.new("ScrollingFrame", pagesContainer)
        page.Size = UDim2.new(1, 0, 1, 0)
        page.BackgroundTransparency = 1
        page.Visible = false
        page.ScrollBarThickness = 4
        page.ScrollBarImageColor3 = currentTheme.accent
        page.CanvasSize = UDim2.new(0, 0, 0, 0)
        page.Name = "Page_" .. name

        local list = Instance.new("UIListLayout", page)
        list.Padding = UDim.new(0, 10)
        list.SortOrder = Enum.SortOrder.LayoutOrder

        list:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            page.CanvasSize = UDim2.new(0, 0, 0, list.AbsoluteContentSize.Y + 10)
        end)

        tab.Page = page

        btn.MouseButton1Click:Connect(function()
            for _, p in ipairs(pagesContainer:GetChildren()) do p.Visible = false end
            for _, b in ipairs(Library.Buttons) do
                b:SetAttribute("Active", false)
                TweenService:Create(b, TweenInfo.new(0.3), { BackgroundColor3 = currentTheme.secondary, TextColor3 = currentTheme.text }):Play()
            end
            page.Visible = true
            btn:SetAttribute("Active", true)
            TweenService:Create(btn, TweenInfo.new(0.3), { BackgroundColor3 = currentTheme.accent, TextColor3 = currentTheme.btnText }):Play()
        end)

        if not isSettings and #Library.Buttons == 1 then
            page.Visible = true
            btn:SetAttribute("Active", true)
            btn.BackgroundColor3 = currentTheme.accent
            btn.TextColor3 = currentTheme.btnText
        end

        return tab
    end

    -- ─── ВКЛАДКА НАСТРОЕК ───
    local settingsTab = Library:CreateTab("✦ Настройки", true)
    for name, data in pairs(THEMES) do
        settingsTab:AddButton(name, "Применить", function()
            applyTheme(data, name)
        end)
    end

    -- Возвращаем библиотеку
    Library.Destroy = cleanup
    return Library
end

return UI
