    pagesContainer.Name = "PagesContainer"
    pagesContainer.Size = UDim2.new(1, -195, 1, -20)
    pagesContainer.Position = UDim2.new(0, 190, 0, 10)
    pagesContainer.BackgroundTransparency = 1

    -- ─── Функция применения темы ───
    local function applyTheme(theme, name)
        currentTheme = theme
        currentThemeName = name

        TweenService:Create(main, TweenInfo.new(0.5), { BackgroundColor3 = theme.bg }):Play()
        TweenService:Create(sidebar, TweenInfo.new(0.5), { BackgroundColor3 = theme.sidebar }):Play()
        TweenService:Create(stroke, TweenInfo.new(0.5), { Color = theme.stroke }):Play()
        TweenService:Create(titleLabel, TweenInfo.new(0.5), { TextColor3 = theme.text }):Play()

        for _, obj in ipairs(pagesContainer:GetDescendants()) do
            if obj:IsA("UIStroke") and obj.Parent:FindFirstChild("SliderKnob") == nil then
                TweenService:Create(obj, TweenInfo.new(0.4), { Color = theme.stroke }):Play()
            elseif obj:IsA("TextLabel") and obj.Parent.Name ~= "ToggleBtnFrame" then
                TweenService:Create(obj, TweenInfo.new(0.4), { TextColor3 = theme.text }):Play()
            elseif obj:IsA("TextButton") then
                if obj.Name == "ActionBtn" or obj.Name == "ToggleBindBtn" or obj.Name == "SliderKnob" then
                    TweenService:Create(obj, TweenInfo.new(0.4), { BackgroundColor3 = theme.accent, TextColor3 = theme.btnText }):Play()
                end
            elseif obj.Name == "Row" or obj.Name == "SliderBack" then
                TweenService:Create(obj, TweenInfo.new(0.4), { BackgroundColor3 = theme.secondary }):Play()
            end
        end

        for _, btn in ipairs(Library.Buttons) do
            if btn:GetAttribute("Active") == true then
                TweenService:Create(btn, TweenInfo.new(0.4), { BackgroundColor3 = theme.accent, TextColor3 = theme.btnText }):Play()
            else
                TweenService:Create(btn, TweenInfo.new(0.4), { BackgroundColor3 = theme.secondary, TextColor3 = theme.text }):Play()
            end
        end

        saveTheme(name)
    end

