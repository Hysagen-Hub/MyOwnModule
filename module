    end

    -- Cleanup Routine
    function Library:Destroy()
        for _, conn in ipairs(Library.Connections) do
            if conn and conn.Disconnect then
                conn:Disconnect()
            end
        end
        Library.Connections = {}
        if ScreenGui then
            ScreenGui:Destroy()
        end
    end

    return Library
end

