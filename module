        bindToggle.TextColor3 = Color3.fromRGB(255, 255, 255)
        bindToggle.Font = Enum.Font.GothamBold
        bindToggle.TextSize = 13
        bindToggle.AutoButtonColor = false
        local bc = Instance.new("UICorner", bindToggle)
        bc.CornerRadius = UDim.new(0, 8)

        -- Bind button
        local bindBtn = Instance.new("TextButton", row)
        bindBtn.Name = "ActionBtn"
        bindBtn.Size = UDim2.new(0.18, 0, 0, 36)
        bindBtn.Position = UDim2.new(0.78, 0, 0.5, -18)
        bindBtn.BackgroundColor3 = currentTheme.accent
        bindBtn.Text = currentKey.Name
        bindBtn.TextColor3 = currentTheme.btnText
        bindBtn.Font = Enum.Font.GothamBold
        bindBtn.TextSize = 14
        local bc2 = Instance.new("UICorner", bindBtn)
        bc2.CornerRadius = UDim.new(0, 8)

        local function setToggle(state)
            toggled = state
            local col = toggled and Color3.fromRGB(80, 255, 120) or Color3.fromRGB(255, 80, 80)
            local txt = toggled and "ON" or "OFF"
            TweenService:Create(dot, TweenInfo.new(0.25, Enum.EasingStyle.Quart), { BackgroundColor3 = col }):Play()
            TweenService:Create(statusLabel, TweenInfo.new(0.25), { TextColor3 = col }):Play()
            statusLabel.Text = txt
            if callback then callback(toggled) end
        end

        local function setBindEnabled(state)
            bindEnabled = state
            bindToggle.BackgroundColor3 = bindEnabled and Color3.fromRGB(80, 255, 120) or Color3.fromRGB(255, 80, 80)
            bindToggle.Text = bindEnabled and "ON" or "OFF"
        end

        -- События
        local c1 = toggleBtn.MouseButton1Click:Connect(function() setToggle(not toggled) end)
        table.insert(conns, c1)
        table.insert(Library.Connections, c1)

        local c2 = bindToggle.MouseButton1Click:Connect(function() setBindEnabled(not bindEnabled) end)
        table.insert(conns, c2)
        table.insert(Library.Connections, c2)

        local c3 = bindBtn.MouseButton1Click:Connect(function()
            binding = true
            bindBtn.Text = "..."
