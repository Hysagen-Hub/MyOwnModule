        screenGui:Destroy()
    end
    closeBtn.MouseButton1Click:Connect(cleanup)
    table.insert(Library.Connections, closeBtn.MouseButton1Click)

    -- ─── Сайдбар ───
    local sidebar = Instance.new("Frame", main)
    sidebar.Name = "Sidebar"
    sidebar.Size = UDim2.new(0, 180, 1, 0)
    sidebar.BackgroundColor3 = currentTheme.sidebar
    sidebar.BackgroundTransparency = 0.2
    sidebar.BorderSizePixel = 0
    local sc = Instance.new("UICorner", sidebar)
    sc.CornerRadius = UDim.new(0, 16)

    local titleLabel = Instance.new("TextLabel", sidebar)
    titleLabel.Size = UDim2.new(1, 0, 0, 60)
    titleLabel.Text = title
    titleLabel.TextColor3 = currentTheme.text
    titleLabel.Font = Enum.Font.GothamBold
    titleLabel.TextSize = 20
    titleLabel.BackgroundTransparency = 1
    titleLabel.TextXAlignment = Enum.TextXAlignment.Center

    local sidebarScroll = Instance.new("ScrollingFrame", sidebar)
    sidebarScroll.Size = UDim2.new(1, -12, 1, -70)
    sidebarScroll.Position = UDim2.new(0, 6, 0, 65)
    sidebarScroll.BackgroundTransparency = 1
    sidebarScroll.ScrollBarThickness = 3
    sidebarScroll.ScrollBarImageColor3 = currentTheme.accent
    sidebarScroll.CanvasSize = UDim2.new(0, 0, 0, 0)

    local tabList = Instance.new("UIListLayout", sidebarScroll)
    tabList.Padding = UDim.new(0, 6)

